# Copy this file to .env.local (already gitignored) and fill in real values.
# Never commit actual secret keys.

# Dodo Payments (dashboard.dodopayments.com -> Developers -> API Keys).
# Create one "Astravia Full Report" product there first and paste its id below.
DODO_PAYMENTS_API_KEY=...
DODO_PAYMENTS_PRODUCT_ID=pdt_...
# "test_mode" (default) or "live_mode".
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Set to "false" once Dodo's live-mode verification is approved and the
# vars above are live credentials -- this makes "Unlock full report"
# require a real payment. Any other value (or leaving it unset) skips
# checkout and unlocks immediately, which is the deliberate default
# while production is still waiting on that approval (docs/DECISIONS.md).
NEXT_PUBLIC_SKIP_PAYMENT=false

# PostHog (app.posthog.com -> Project Settings -> Project API Key).
# Public/write-only key, safe to expose client-side. Leave unset to
# disable analytics entirely -- initPostHog() is a no-op without it.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Match whichever region you picked at signup: US cloud (default) is
# https://us.i.posthog.com, EU cloud is https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
